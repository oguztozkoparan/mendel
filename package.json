{
  "name": "mendel",
  "version": "0.1.1",
  "private": true,
  "description": "Cross-platform desktop git client",
  "author": "mendel",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "e2e": "electron-vite build --mode e2e && playwright test",
    "dist:smoke": "electron-vite build --mode e2e && electron-builder --dir --publish never -c.directories.output=release-smoke",
    "dist": "npm run build && electron-builder --publish never",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "electron-log": "5.4.4",
    "electron-updater": "6.8.11",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tanstack/react-query": "5.105.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "lucide-react": "1.68.0",
    "motion": "14.6.0",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-diff-view": "3.3.3",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "refractor": "5.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
